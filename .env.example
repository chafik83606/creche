# Firebase — copier vers mobile/.env et web/.env.local

# --- Émulateurs (dev) ---
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-creche
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-creche.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:demo
EXPO_PUBLIC_USE_EMULATORS=true

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-creche
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-creche.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:demo
NEXT_PUBLIC_USE_EMULATORS=true

