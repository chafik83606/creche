{
  "expo": {
    "name": "Creche Connect",
    "slug": "creche",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "creche",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4a90d9"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4a90d9",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "fr.creche.app",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.creche.app",
      "buildNumber": "10",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4a90d9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Creche Connect à accéder à vos photos pour les partager dans le chat.",
          "cameraPermission": "Autoriser Creche Connect à utiliser la caméra pour le chat."
        }
      ],
      "./plugins/withAndroidSigning.js",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2ae1b4b8-2440-429b-b1d3-0dfaf4966ffa"
      }
    },
    "owner": "chafik83s-team"
  }
}
