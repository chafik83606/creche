{
  "expo": {
    "name": "Zibou",
    "slug": "creche",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "creche",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "fr.creche.app",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.creche.app",
      "buildNumber": "12",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Zibou a besoin du micro pour envoyer des messages audio."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E91E8C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Zibou à accéder à vos photos pour les partager dans le chat.",
          "cameraPermission": "Autoriser Zibou à utiliser la caméra pour le chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Autoriser Zibou à utiliser le micro pour les messages audio."
        }
      ],
      "./plugins/withAndroidSigning.js",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2ae1b4b8-2440-429b-b1d3-0dfaf4966ffa"
      }
    },
    "owner": "chafik83s-team"
  }
}
